generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  MEMBER
  FREELANCER
  CLIENT
  FOUNDER
  INVESTOR
  PROPERTY_OWNER
  ADMIN
  MASTER_ADMIN
  INTERNAL_TESTER
}

enum AccountClassification {
  PUBLIC_BETA_USER
  INTERNAL_TEST_USER
  INTERNAL_ADMIN
  SYSTEM_ACCOUNT
}

/**
 * Lifecycle of a request for trading (content creation) access.
 *
 * Modelled as an explicit application rather than a self-service toggle so the
 * grant is reviewable and attributable. `NEEDS_CHANGES` exists so a reviewer can
 * return an application without destroying the applicant's answers.
 */
enum TraderApplicationStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  SUSPENDED
}

enum TraderApplicantKind {
  INDIVIDUAL
  BUSINESS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OpportunityType {
  JOB
  FREELANCE_PROJECT
  STARTUP
  COFOUNDER
  INVESTMENT
  PROPERTY
  SERVICE
  PRODUCT
  PARTNERSHIP
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ConversationStatus {
  ACTIVE
  BLOCKED
  REPORTED
  ARCHIVED
}

enum MessageAttachmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProposalStatus {
  DRAFT
  SENT
  WITHDRAWN
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

enum ProposalVersionStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ConversationEventType {
  PROPOSAL_SUBMITTED
  PROPOSAL_OBJECTION_RAISED
  PROPOSAL_REVISION_CREATED
  PROPOSAL_REVISION_SUBMITTED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  DEAL_CREATED
  DEAL_STATUS_CHANGED
  MILESTONE_SUBMITTED
  MILESTONE_APPROVED
  SIMULATED_RELEASE_RECORDED
}

enum DealSettlementMode {
  SIMULATED
  PROVIDER_DISABLED
}

enum DealStatus {
  DRAFT
  AWAITING_FUNDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RELEASED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  RESOLVED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
  CANCELLED
  DISPUTED
}

enum DeliveryStatus {
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum LedgerEntryType {
  FUNDING_HELD
  RELEASE
  REFUND
  ADJUSTMENT
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum UserReportTargetType {
  MESSAGE
  CONVERSATION
  USER
  OPPORTUNITY
  DEAL
  REVIEW
  REAL_ESTATE_LISTING
  OTHER_CONTENT
}

enum UserReportStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_TAKEN
  RESOLVED
  DISMISSED
}

enum ModerationCaseStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_REVIEW
  NEEDS_INFORMATION
  ACTION_REQUIRED
  ESCALATED
  RESOLVED
  DISMISSED
  APPEALED
  CLOSED
}

enum ModerationCaseSource {
  USER_REPORT
  MESSAGE_REPORT
  CONVERSATION_REPORT
  LISTING_REPORT
  DEAL_DISPUTE
  POLICY_FLAG
  SUPPORT_CASE
  SECURITY_INVESTIGATION
}

enum EnforcementActionType {
  WARNING
  MESSAGING_RESTRICTION
  CONNECTION_REQUEST_RESTRICTION
  PUBLISHING_RESTRICTION
  VERIFICATION_REQUIRED
  TEMPORARY_SUSPENSION
  INDEFINITE_SUSPENSION
  DEACTIVATION
  PERMANENT_BAN
  SESSION_REVOCATION
  RESTORATION
}

enum EnforcementActionStatus {
  ACTIVE
  EXPIRED
  REVERSED
}

enum EnforcementAppealStatus {
  SUBMITTED
  IN_REVIEW
  UPHELD
  MODIFIED
  REVERSED
  DISMISSED
}

enum ReviewVisibility {
  PUBLIC
  HIDDEN
}

enum NotificationType {
  SYSTEM
  BROADCAST
  MESSAGE
  NEW_MESSAGE
  MESSAGE_REQUEST_RECEIVED
  PROPOSAL
  OPPORTUNITY_RESPONSE
  PROPOSAL_UPDATE
  DEAL
  DEAL_UPDATE
  REVIEW
  MODERATION
  MODERATION_UPDATE
  SUPPORT
  SUPPORT_REPLY
  CONNECTION
  CONNECTION_REQUEST_RECEIVED
  CONNECTION_REQUEST_ACCEPTED
  CONNECTION_REQUEST_DECLINED
}

enum PropertyVerificationState {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  PUBLISHED
  REJECTED
  PAUSED
  ARCHIVED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  BLOCKED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SponsoredContentStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

model User {
  id                                String                    @id @default(cuid())
  email                             String                    @unique
  passwordHash                      String
  name                              String
  username                          String                    @unique
  accountClassification             AccountClassification     @default(PUBLIC_BETA_USER)
  imageUrl                          String?
  imageStorageKey                   String?
  emailVerifiedAt                   DateTime?
  verificationStatus                VerificationStatus        @default(UNVERIFIED)
  isActive                          Boolean                   @default(true)
  messagingRestrictedUntil          DateTime?
  connectionRequestsRestrictedUntil DateTime?
  publishingRestrictedUntil         DateTime?
  suspendedAt                       DateTime?
  suspendedUntil                    DateTime?
  deactivatedAt                     DateTime?
  bannedAt                          DateTime?
  enforcementReasonPublic           String?
  onboardingDismissedAt             DateTime?
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt
  sessions                          Session[]
  passwordResetTokens               PasswordResetToken[]
  traderApplication                 TraderApplication?
  roles                             UserRole[]
  profile                           Profile?
  opportunities                     Opportunity[]             @relation("OpportunityOwner")
  bookmarks                         OpportunityBookmark[]
  reports                           OpportunityReport[]       @relation("Reporter")
  userReports                       UserReport[]              @relation("UserReportReporter")
  proposals                         Proposal[]                @relation("ProposalSender")
  conversations                     ConversationParticipant[]
  messages                          Message[]
  deals                             DealParticipant[]
  deliveries                        Delivery[]
  approvals                         Approval[]
  releases                          Release[]
  refunds                           Refund[]
  disputesOpened                    Dispute[]                 @relation("DisputeOpenedBy")
  reviewsGiven                      Review[]                  @relation("ReviewAuthor")
  reviewsReceived                   Review[]                  @relation("ReviewSubject")
  notifications                     Notification[]
  auditLogs                         AuditLog[]                @relation("AuditActor")
  moderationActions                 ModerationAction[]        @relation("ModerationActor")
  connectionsSent                   Connection[]              @relation("ConnectionRequester")
  connectionsReceived               Connection[]              @relation("ConnectionReceiver")
  blocksMade                        BlockedUser[]             @relation("BlocksMade")
  blocksReceived                    BlockedUser[]             @relation("BlocksReceived")
  profileBookmarks                  ProfileBookmark[]
  supportTickets                    SupportTicket[]
  ticketMessages                    TicketMessage[]

  @@index([createdAt])
  @@index([accountClassification])
  @@index([isActive, accountClassification])
  @@index([messagingRestrictedUntil])
  @@index([connectionRequestsRestrictedUntil])
  @@index([publishingRestrictedUntil])
  @@index([suspendedUntil])
  @@index([bannedAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use password reset grant.
///
/// Only the SHA-256 hash of the emitted token is stored, mirroring `Session`,
/// so a database disclosure cannot be replayed as a reset link. `consumedAt`
/// makes redemption idempotent and auditable without retaining the raw token.
model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  requestedByAdminId String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * A user's request for trading access.
 *
 * One row per user (`userId @unique`): re-applying updates the existing record
 * so the review history stays in one place rather than accumulating duplicates.
 *
 * Deliberately small. Identity documents are NOT collected - no verification
 * requirement exists that would justify holding them, and the approval decision
 * is a human review of stated intent.
 */
model TraderApplication {
  id             String                  @id @default(cuid())
  userId         String                  @unique
  status         TraderApplicationStatus @default(DRAFT)
  applicantKind  TraderApplicantKind     @default(INDIVIDUAL)
  tradeCategory  String
  headline       String
  experience     String
  reviewerId     String?
  reviewerNote   String?
  submittedAt    DateTime?
  decidedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  label       String
  description String
  users       UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Profile {
  id                           String                @id @default(cuid())
  userId                       String                @unique
  headline                     String
  biography                    String
  location                     String
  websiteUrl                   String?
  profileImageUrl              String?
  profileImageStorageKey       String?
  isDiscoverable               Boolean               @default(true)
  showLocation                 Boolean               @default(true)
  showSkills                   Boolean               @default(true)
  allowConnectionRequests      Boolean               @default(true)
  allowMessagesFromConnections Boolean               @default(true)
  allowMessagesFromMembers     Boolean               @default(false)
  showPresence                 Boolean               @default(true)
  showLastActiveTime           Boolean               @default(false)
  trustScore                   Int                   @default(0)
  profileCompleteness          Int                   @default(0)
  completedDeals               Int                   @default(0)
  averageRating                Decimal               @default(0) @db.Decimal(3, 2)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  user                         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                       ProfileSkill[]
  portfolio                    PortfolioItem[]
  workHistory                  WorkHistory[]
  verificationRequests         VerificationRequest[]
  profileBookmarks             ProfileBookmark[]

  @@index([isDiscoverable, updatedAt])
  @@index([location])
}

model ProfileSkill {
  id        String  @id @default(cuid())
  profileId String
  name      String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([name])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String
  url         String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model WorkHistory {
  id        String    @id @default(cuid())
  profileId String
  title     String
  company   String
  summary   String
  startedAt DateTime?
  endedAt   DateTime?
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id        String             @id @default(cuid())
  profileId String
  status    VerificationStatus @default(PENDING)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model OpportunityCategory {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String
  opportunities Opportunity[]
}

model Opportunity {
  id                        String                     @id @default(cuid())
  ownerId                   String
  categoryId                String?
  type                      OpportunityType
  status                    OpportunityStatus          @default(DRAFT)
  moderationStatus          ModerationStatus           @default(PENDING)
  propertyVerificationState PropertyVerificationState?
  propertyType              String?
  propertyListingType       String?
  contactPreference         String?
  authorityDeclaration      String?
  listingRulesAccepted      Boolean                    @default(false)
  verificationNotes         String?
  title                     String
  slug                      String                     @unique
  summary                   String
  description               String
  location                  String?
  remote                    Boolean                    @default(true)
  budgetMinMinor            BigInt?
  budgetMaxMinor            BigInt?
  currency                  String                     @default("NGN")
  skills                    String[]                   @default([])
  publishedAt               DateTime?
  pausedAt                  DateTime?
  closedAt                  DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  owner                     User                       @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category                  OpportunityCategory?       @relation(fields: [categoryId], references: [id])
  bookmarks                 OpportunityBookmark[]
  reports                   OpportunityReport[]
  statusHistory             OpportunityStatusHistory[]
  proposals                 Proposal[]
  conversations             Conversation[]
  images                    OpportunityImage[]

  // Serves the Home feed's [publishedAt desc, id desc] keyset ordering.
  //
  // A wider variant ending in `id` was benchmarked for Batch 2 and rejected:
  // Prisma's typed API emits the keyset tie-breaker as an OR predicate, which
  // Postgres cannot push into an index condition, so the extra column was never
  // used and the query measured slightly slower (2.03ms vs 1.64ms at 50k posts,
  // ~4800 rows deep). Reconsider only alongside a raw-SQL row-values cursor
  // (`(publishedAt, id) < (...)`), which does push down and measured 0.11ms.
  @@index([status, moderationStatus, publishedAt])
  @@index([ownerId, status])
  @@index([ownerId, status, updatedAt])
  @@index([type])
  @@index([categoryId])
  @@index([type, status, moderationStatus, publishedAt])
  @@index([propertyVerificationState])
}

model OpportunityImage {
  id            String      @id @default(cuid())
  opportunityId String
  uploaderId    String
  url           String
  storageKey    String
  mimeType      String
  byteSize      Int
  altText       String?
  isCover       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([uploaderId])
  @@index([opportunityId, isCover])
}

model OpportunityBookmark {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
}

model OpportunityReport {
  id            String       @id @default(cuid())
  opportunityId String
  reporterId    String
  reason        String
  details       String?
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reporter      User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model UserReport {
  id                    String               @id @default(cuid())
  reporterId            String
  targetType            UserReportTargetType
  targetId              String
  category              String
  details               String?
  status                UserReportStatus     @default(SUBMITTED)
  contextConversationId String?
  contextMessageId      String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  reporter              User                 @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderationCases       ModerationCase[]

  @@unique([reporterId, targetType, targetId, status])
  @@index([reporterId, status, createdAt])
  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([category, status])
}

model ModerationCase {
  id                        String                   @id @default(cuid())
  source                    ModerationCaseSource
  status                    ModerationCaseStatus     @default(NEW)
  priority                  String                   @default("NORMAL")
  category                  String
  title                     String
  summary                   String
  targetType                String
  targetId                  String
  reporterId                String?
  reportedUserId            String?
  assignedAdminId           String?
  linkedReportId            String?
  linkedOpportunityReportId String?
  conversationId            String?
  messageId                 String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  linkedReport              UserReport?              @relation(fields: [linkedReportId], references: [id], onDelete: SetNull)
  events                    ModerationCaseEvent[]
  messageScopes             ModerationMessageScope[]
  enforcementActions        EnforcementAction[]
  appeals                   EnforcementAppeal[]

  @@index([status, createdAt])
  @@index([source, status])
  @@index([targetType, targetId])
  @@index([conversationId])
  @@index([assignedAdminId, status])
  @@index([linkedReportId])
}

model ModerationCaseEvent {
  id             String                @id @default(cuid())
  caseId         String
  actorId        String?
  type           String
  reason         String?
  note           String?
  previousStatus ModerationCaseStatus?
  nextStatus     ModerationCaseStatus?
  createdAt      DateTime              @default(now())
  case           ModerationCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model ModerationMessageScope {
  id             String         @id @default(cuid())
  caseId         String
  conversationId String
  messageId      String?
  revealedById   String
  reason         String
  scope          String
  timeRangeStart DateTime?
  timeRangeEnd   DateTime?
  createdAt      DateTime       @default(now())
  case           ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([conversationId, createdAt])
  @@index([revealedById, createdAt])
}

model EnforcementAction {
  id                    String                  @id @default(cuid())
  caseId                String
  actorId               String
  targetUserId          String
  type                  EnforcementActionType
  status                EnforcementActionStatus @default(ACTIVE)
  reason                String
  userFacingExplanation String
  internalNote          String
  previousState         Json?
  newState              Json?
  expiresAt             DateTime?
  appealAllowed         Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  case                  ModerationCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appeals               EnforcementAppeal[]

  @@index([caseId, createdAt])
  @@index([targetUserId, status])
  @@index([type, status])
  @@index([expiresAt])
}

model EnforcementAppeal {
  id                  String                  @id @default(cuid())
  enforcementActionId String
  caseId              String
  appellantId         String
  reviewerId          String?
  status              EnforcementAppealStatus @default(SUBMITTED)
  body                String
  resolution          String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  enforcementAction   EnforcementAction       @relation(fields: [enforcementActionId], references: [id], onDelete: Cascade)
  case                ModerationCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([appellantId, status, createdAt])
  @@index([caseId, status])
  @@index([enforcementActionId])
}

model OpportunityStatusHistory {
  id            String             @id @default(cuid())
  opportunityId String
  fromStatus    OpportunityStatus?
  toStatus      OpportunityStatus
  actorId       String?
  note          String?
  createdAt     DateTime           @default(now())
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String                    @id @default(cuid())
  opportunityId String?
  status        ConversationStatus        @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  opportunity   Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]
  events        ConversationEvent[]
  proposals     Proposal[]

  @@index([opportunityId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  removedAt      DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([userId, lastReadAt])
  @@index([userId, removedAt])
}

model Message {
  id               String               @id @default(cuid())
  conversationId   String
  senderId         String
  replyToMessageId String?
  body             String
  editedAt         DateTime?
  deletedAt        DateTime?
  deletedById      String?
  createdAt        DateTime             @default(now())
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo          Message?             @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]            @relation("MessageReplies")
  sender           User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments      MessageAttachment[]
  edits            MessageEdit[]
  readReceipts     MessageReadReceipt[]

  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@index([senderId, createdAt])
  @@index([editedAt])
}

model MessageEdit {
  id               String   @id @default(cuid())
  messageId        String
  editorId         String
  previousBodyHash String
  nextBodyHash     String
  createdAt        DateTime @default(now())
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([editorId, createdAt])
}

model MessageAttachment {
  id        String                  @id @default(cuid())
  messageId String
  filename  String
  url       String
  mimeType  String
  byteSize  Int
  status    MessageAttachmentStatus @default(PENDING)
  createdAt DateTime                @default(now())
  message   Message                 @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model BlockedUser {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())
  blocker       User     @relation("BlocksMade", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("BlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

model Proposal {
  id             String                  @id @default(cuid())
  opportunityId  String
  senderId       String
  conversationId String?
  status         ProposalStatus          @default(SENT)
  amountMinor    BigInt
  currency       String                  @default("NGN")
  description    String
  deliveryDays   Int
  revisions      Int                     @default(1)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  opportunity    Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sender         User                    @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  milestones     ProposalMilestone[]
  versions       ProposalVersion[]
  statusHistory  ProposalStatusHistory[]
  deal           Deal?

  @@index([opportunityId, status])
  @@index([senderId, status])
}

model ProposalVersion {
  id                  String                     @id @default(cuid())
  proposalId          String
  versionNumber       Int
  status              ProposalVersionStatus      @default(DRAFT)
  amountMinor         BigInt
  currency            String                     @default("NGN")
  description         String
  deliveryDays        Int
  includedRevisions   Int                        @default(1)
  createdById         String
  supersedesVersionId String?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  proposal            Proposal                   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  supersedes          ProposalVersion?           @relation("ProposalVersionLineage", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  revisions           ProposalVersion[]          @relation("ProposalVersionLineage")
  milestones          ProposalVersionMilestone[]
  events              ConversationEvent[]
  deal                Deal?                      @relation("AcceptedProposalVersion")

  @@unique([id, proposalId])
  @@unique([proposalId, versionNumber])
  @@index([proposalId, status, createdAt])
  @@index([supersedesVersionId])
}

model ProposalVersionMilestone {
  id                String          @id @default(cuid())
  proposalVersionId String
  position          Int
  title             String
  description       String
  amountMinor       BigInt
  dueInDays         Int
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)

  @@unique([proposalVersionId, position])
}

model ConversationEvent {
  id                String                @id @default(cuid())
  conversationId    String
  actorId           String?
  type              ConversationEventType
  proposalVersionId String?
  dealId            String?
  snapshot          Json
  idempotencyKey    String                @unique
  createdAt         DateTime              @default(now())
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  proposalVersion   ProposalVersion?      @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  deal              Deal?                 @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([proposalVersionId])
  @@index([dealId])
}

model ProposalMilestone {
  id          String   @id @default(cuid())
  proposalId  String
  title       String
  description String
  amountMinor BigInt
  dueInDays   Int
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model ProposalStatusHistory {
  id         String          @id @default(cuid())
  proposalId String
  fromStatus ProposalStatus?
  toStatus   ProposalStatus
  actorId    String?
  note       String?
  createdAt  DateTime        @default(now())
  proposal   Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Deal {
  id                 String                @id @default(cuid())
  proposalId         String                @unique
  proposalVersionId  String
  opportunityId      String
  status             DealStatus            @default(AWAITING_FUNDING)
  settlementMode     DealSettlementMode    @default(SIMULATED)
  valueMinor         BigInt
  currency           String                @default("NGN")
  idempotencyKey     String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  proposal           Proposal              @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  proposalVersion    ProposalVersion       @relation("AcceptedProposalVersion", fields: [proposalVersionId, proposalId], references: [id, proposalId], onDelete: Restrict)
  participants       DealParticipant[]
  milestones         DealMilestone[]
  deliveries         Delivery[]
  approvals          Approval[]
  releases           Release[]
  refunds            Refund[]
  disputes           Dispute[]
  ledgerEntries      LedgerEntry[]
  statusHistory      EscrowStatusHistory[]
  reviews            Review[]
  conversationEvents ConversationEvent[]

  @@unique([proposalVersionId, proposalId])
  @@index([status, createdAt])
}

model DealParticipant {
  id        String   @id @default(cuid())
  dealId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([userId])
}

model DealMilestone {
  id          String          @id @default(cuid())
  dealId      String
  title       String
  description String
  amountMinor BigInt
  currency    String          @default("NGN")
  status      MilestoneStatus @default(PENDING)
  dueAt       DateTime?
  createdAt   DateTime        @default(now())
  deal        Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]
  approvals   Approval[]
  releases    Release[]

  @@unique([id, dealId])
}

model Delivery {
  id          String         @id @default(cuid())
  dealId      String
  milestoneId String?
  submitterId String
  title       String
  notes       String
  status      DeliveryStatus @default(SUBMITTED)
  createdAt   DateTime       @default(now())
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestone   DealMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  submitter   User           @relation(fields: [submitterId], references: [id], onDelete: Cascade)
}

model Approval {
  id          String         @id @default(cuid())
  dealId      String
  milestoneId String?
  actorId     String
  note        String?
  createdAt   DateTime       @default(now())
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestone   DealMilestone? @relation(fields: [milestoneId, dealId], references: [id, dealId], onDelete: Restrict)
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model Release {
  id             String         @id @default(cuid())
  dealId         String
  milestoneId    String?
  actorId        String
  amountMinor    BigInt
  currency       String
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  deal           Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestone      DealMilestone? @relation(fields: [milestoneId, dealId], references: [id, dealId], onDelete: Restrict)
  actor          User           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model Refund {
  id             String   @id @default(cuid())
  dealId         String
  actorId        String
  amountMinor    BigInt
  currency       String
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model Dispute {
  id         String   @id @default(cuid())
  dealId     String
  openedById String
  reason     String
  status     String   @default("OPEN")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  openedBy   User     @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id             String          @id @default(cuid())
  dealId         String
  type           LedgerEntryType
  amountMinor    BigInt
  currency       String
  idempotencyKey String          @unique
  note           String?
  createdAt      DateTime        @default(now())
  deal           Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model EscrowStatusHistory {
  id         String      @id @default(cuid())
  dealId     String
  fromStatus DealStatus?
  toStatus   DealStatus
  actorId    String?
  reason     String?
  createdAt  DateTime    @default(now())
  deal       Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Review {
  id         String           @id @default(cuid())
  dealId     String
  authorId   String
  subjectId  String
  rating     Int
  title      String
  body       String
  visibility ReviewVisibility @default(PUBLIC)
  createdAt  DateTime         @default(now())
  deal       Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author     User             @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject    User             @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([dealId, authorId, subjectId])
  @@index([subjectId, createdAt])
}

model TrustSignal {
  id        String   @id @default(cuid())
  userId    String
  key       String
  label     String
  value     Int
  weight    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  actionUrl   String?
  actionState String?
  broadcastId String?
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast   AdminBroadcast?  @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@unique([userId, broadcastId])
  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([broadcastId])
}

model AdminBroadcast {
  id            String              @id @default(cuid())
  senderId      String
  title         String
  body          String
  audience      String
  priority      String              @default("NORMAL")
  actionUrl     String?
  expiresAt     DateTime?
  deliveryCount Int                 @default(0)
  failedCount   Int                 @default(0)
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  notifications Notification[]
  deliveries    BroadcastDelivery[]

  @@index([senderId, createdAt])
  @@index([audience, createdAt])
}

model BroadcastDelivery {
  id             String         @id @default(cuid())
  broadcastId    String
  userId         String
  notificationId String?
  status         String
  error          String?
  createdAt      DateTime       @default(now())
  broadcast      AdminBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([entityType, action, createdAt, id])
  @@index([actorId, createdAt])
}

model ModerationAction {
  id         String   @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  action     String
  reason     String
  createdAt  DateTime @default(now())
  actor      User     @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([requesterId, status])
  @@index([receiverId, status])
  @@index([status])
}

model ProfileBookmark {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@index([userId])
}

model SupportTicket {
  id        String          @id @default(cuid())
  authorId  String
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([authorId])
  @@index([status])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SponsoredContent {
  id        String                 @id @default(cuid())
  brandName String
  message   String
  ctaLabel  String
  ctaHref   String
  imageUrl  String?
  status    SponsoredContentStatus @default(DRAFT)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime               @default(now())

  @@index([status, startsAt])
  @@index([status, startsAt, endsAt])
}
